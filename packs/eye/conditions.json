    {
      "id": "normal",
      "name": {
        "en": "No significant findings",
        "fil": "Walang makabuluhang nakita"
      },
      "default_urgency": "routine",
      "emergency": false,
      "zero_shot_prompts": [
        "a photo of a healthy human eye with a white sclera and clear cornea"
      ],
      "visual_features": {
        "en": "White of the eye clear, cornea clear, no redness",
        "fil": "Malinaw ang puti ng mata at cornea, walang pamumula"
      },
      "evidence": [
        {
          "direction": "against",
          "text": {
            "en": "Redness reported",
            "fil": "May pamumula"
          },
          "when": {
            "fact": "exam.symptoms",
            "op": "contains",
            "value": "redness"
          }
        },
        {
          "direction": "against",
          "text": {
            "en": "Moderate or severe pain",
            "fil": "Katamtaman o matinding sakit"
          },
          "when": {
            "fact": "exam.pain_severity",
            "op": "in",
            "value": [
              "moderate",
              "severe"
            ]
          }
        },
        {
          "direction": "against",
          "text": {
            "en": "Change in vision",
            "fil": "May pagbabago sa paningin"
          },
          "when": {
            "fact": "exam.vision_change",
            "op": "in",
            "value": [
              "mild_blur",
              "gradual_reduction",
              "marked_reduction",
              "sudden_loss"
            ]
          }
        }
      ]
    },
