# Copy to .env and fill in. Never commit .env.
APP_ENV=development                 # development | test | production
DATABASE_URL=postgresql+psycopg://scanassist:scanassist@localhost:5432/scanassist

# Photo storage. Local dev uses MinIO from docker-compose; production uses a GCS bucket
# in asia-southeast1 via its S3-compatible endpoint (HMAC keys).
STORAGE_BACKEND=s3                  # local | s3
STORAGE_BUCKET=scanassist-photos
STORAGE_REGION=asia-southeast1      # must be asia-southeast1 in production
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
PHOTO_DRAFT_TTL_HOURS=72

MODEL_DIR=./models
PACKS_DIR=./packs

# Classifier: stub (dev, fake probabilities) | zero_shot (MedSigLIP) | onnx | none
CLASSIFIER=stub
MEDSIGLIP_MODEL_ID=google/medsiglip-448
HF_TOKEN=

# Report polishing: none | medgemma_selfhosted
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=google/medgemma-4b-it
LLM_TIMEOUT_MS=8000

JWT_SECRET=change-me
PATIENT_HASH_SALT=change-me
