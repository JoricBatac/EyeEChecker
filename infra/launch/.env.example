# Launch stack secrets. Copy to .env on the VM only. Never commit .env.
API_DOMAIN=api.example.ph
WEB_DOMAIN=app.example.ph
POSTGRES_PASSWORD=
JWT_SECRET=                 # openssl rand -hex 32
PATIENT_HASH_SALT=          # openssl rand -hex 16

# GCS bucket in asia-southeast1, accessed with HMAC keys (Cloud Storage > Settings > Interoperability)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
PHOTO_DRAFT_TTL_HOURS=72

CLASSIFIER=zero_shot
HF_TOKEN=                   # Hugging Face read token with MedSigLIP terms accepted

LLM_PROVIDER=none           # Phase 1: templates only
LLM_BASE_URL=
LLM_TIMEOUT_MS=8000

BACKUP_BUCKET=
BACKUP_PASSPHRASE=          # store a copy offline; backups are useless without it
